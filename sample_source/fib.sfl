import "stdio" as io

io.write("input n: ")
n := eval io.readline()

# O(n) algorithm to solve fibonacci array
_raw_fib := fn (mem, pos) with [] {
    return if (mem[pos] != {}) then {
        return mem
    } else {
        return if (pos <= 2) then {
            mem := mem[pos := 1]
            return mem
        }else {
            mem := self(mem, pos - 2)
            mem := self(mem, pos - 1)
            mem := mem[pos := mem[pos - 1] + mem[pos - 2]]
            return mem
        }
    }
}

# calculate interface
fib := fn (idx) with [][
    "_raw_fib" := _raw_fib
] {
    return _raw_fib([], idx)[idx]
}

io.print("fib(" + repr(n) + ") = " + repr(fib(n)))
io.print(repr(fib))
