import "stdio"

# print will output a "\n" after the content
txt := "hello world!"
stdio.print(txt)

# write will not output a "\n" after the content
stdio.write("plese input your name: ")
content := stdio.readline()
content := content[(len content) - 1 := {}] # erase the final "\n"
stdio.print("hello, " + content + "!")
