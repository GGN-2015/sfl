import "stdio" as io

hello := fn () with [][
    "print" := io.print
] {
    # print will output a "\n" after the content
    txt := "hello world!"
    print(txt)
}

hi_name := fn () with [][
    "write" := io.write
    "print" := io.print
    "readline" := io.readline
] {
    # write will not output a "\n" after the content
    write("plese input your name: ")
    content := readline()
    content := content[(len content) - 1 := {}] # erase the final "\n"
    print("hello, " + content + "!")
}

hello()
hi_name()
