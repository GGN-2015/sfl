not := fn (x) with [] {
    return if x == 0 then {
        return 1
    } else {
        return 0
    }
}
export not

and := fn (x, y) with [] {
    return if (x == 0) then {
        return 0
    } else {
        return if (y == 0) then {
            return 0
        } else {
            return 1
        }
    }
}
export and

or := fn (x, y) with [][
    "and" := and
    "not" := not
] {
    return not(and(not(x), not(y)))
}
export or
